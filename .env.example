# Discord bot/gateway
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register guild-scoped commands for faster local iteration.
DISCORD_GUILD_ID=

# Rust voice sidecar
JETTBOT_RUST_SIDECAR_PATH=./target/release/jettbot-voice-sidecar
JETTBOT_IPC_MODE=stdio
JETTBOT_LOG_LEVEL=info
JETTBOT_LOG_FILE_PATH=./logs/jettbot.log.jsonl
JETTBOT_SIDECAR_LOG_FILE_PATH=./logs/sidecar.log
JETTBOT_SIDECAR_CONSOLE_LEVEL=warn
JETTBOT_SIDECAR_RUST_LOG=warn,jettbot_voice_sidecar=info
JETTBOT_REALTIME_DEBUG_ENABLED=true
JETTBOT_REALTIME_DEBUG_DIR=./logs/realtime

# AssemblyAI streaming transcription
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=u3-rt-pro
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_TRANSCRIPTION_PROMPT=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4

# Brave Search API
BRAVE_SEARCH_API_KEY=
JETTBOT_IMAGE_SEARCH_COUNT=20
JETTBOT_IMAGE_SEARCH_RATE_LIMIT_COUNT=5
JETTBOT_IMAGE_SEARCH_RATE_LIMIT_WINDOW_MS=60000
JETTBOT_IMAGE_SEARCH_SESSION_TTL_MS=600000

# Turso/libSQL memory
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# YouTube/audio utilities
YOUTUBE_COOKIES_PATH=
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
