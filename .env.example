# Discord bot/gateway
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register guild-scoped commands for faster local iteration.
DISCORD_GUILD_ID=

# Rust voice sidecar
JETTBOT_RUST_SIDECAR_PATH=./target/release/jettbot-voice-sidecar
JETTBOT_IPC_MODE=stdio
JETTBOT_LOG_LEVEL=info

# AssemblyAI streaming transcription
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=u3-rt-pro
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_TRANSCRIPTION_PROMPT=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=opus_48000_128

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4

# Turso/libSQL memory
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# YouTube/audio utilities
YOUTUBE_COOKIES_PATH=
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

